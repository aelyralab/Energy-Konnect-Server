# Energy Konnect API — environment template
# Copy to .env and fill in. Every variable is validated at boot by
# src/config/env.js; the server refuses to start if something required is
# missing or malformed.

NODE_ENV=development
PORT=4000
# Comma-separated list is allowed for multiple frontend origins.
CLIENT_ORIGIN=http://localhost:3000
# The API's own externally-reachable URL — used to build absolute links in
# emails (the notification unsubscribe link). In production this is your
# deployed API's public origin, not the client's.
API_BASE_URL=http://localhost:4000
LOG_LEVEL=info
# Set to true ONLY when running behind a reverse proxy (Render, Railway, Fly,
# nginx). Trusting X-Forwarded-For when you are not behind a proxy lets any
# client spoof its IP and bypass per-IP rate limits.
TRUST_PROXY=false

# --- Database (Neon) --------------------------------------------------------
# DATABASE_URL is the pooled connection used by the app.
# DIRECT_URL is the unpooled one used by `prisma migrate` — migrations fail
# against PgBouncer. Neon shows both in the dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/energy_konnect?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/energy_konnect?sslmode=require"

# --- Redis (Upstash) --------------------------------------------------------
# Optional. Without it the API runs with caching and distributed rate limiting
# disabled — degraded, not broken.
REDIS_URL="rediss://default:PASSWORD@YOUR-ENDPOINT.upstash.io:6379"

# --- Auth -------------------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECRET=
# COOKIE_DOMAIN=.energykonnect.com

# --- OTP / guest limit ------------------------------------------------------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
GUEST_ARTICLE_LIMIT=2

# --- Email ------------------------------------------------------------------
# console = log the message instead of sending (default, zero setup).
# smtp    = Gmail SMTP — recommended for development.
# resend  = Resend HTTP API — required in production.
EMAIL_PROVIDER=console
EMAIL_FROM="Energy Konnect <noreply@energykonnect.local>"

# Gmail SMTP (development). SMTP_PASS must be a Google "App Password" — Google
# Account → Security → 2-Step Verification → App passwords. A normal Gmail
# account password will not authenticate.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Resend (production).
RESEND_API_KEY=

# --- Storage ----------------------------------------------------------------
# local = write to LOCAL_UPLOAD_DIR on disk. Rejected in production.
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=.uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Notifications (src/worker.js) ------------------------------------------
# How often the outbox worker polls for pending emails. This interval also
# acts as the retry backoff between an email's send attempts.
EMAIL_OUTBOX_POLL_INTERVAL_MS=10000
EMAIL_OUTBOX_BATCH_SIZE=20
EMAIL_OUTBOX_MAX_ATTEMPTS=3
